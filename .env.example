# Copy this file to config/.env.qa (or config/.env.<env>) and fill in values.
# Never commit real .env files. They are gitignored on purpose.

# E-commerce demo (https://www.saucedemo.com)
ECOMMERCE_BASE_URL=https://www.saucedemo.com
ECOM_STANDARD_USER=standard_user
ECOM_LOCKED_USER=locked_out_user
ECOM_PROBLEM_USER=problem_user
ECOM_PERFORMANCE_USER=performance_glitch_user
ECOM_PASSWORD=secret_sauce

# Airline demo (https://blazedemo.com)
AIRLINE_BASE_URL=https://blazedemo.com

# Insurance demo
INSURANCE_BASE_URL=https://www.geico.com

# Public sandbox API used in airline tests
API_BASE_URL=https://reqres.in/api
API_KEY=reqres-free-v1

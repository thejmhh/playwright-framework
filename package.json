{
  "name": "playwright-framework",
  "version": "1.0.0",
  "description": "Multi-domain QA automation framework built with Playwright + TypeScript. Demonstrates Page Object Model, custom fixtures, data-driven testing, API testing, multi-environment configuration, Allure reporting and CI/CD on both GitHub Actions and GitLab CI.",
  "main": "playwright.config.ts",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:ecommerce": "playwright test --project=ecommerce",
    "test:airline": "playwright test --project=airline",
    "test:api": "playwright test --project=api tests/api",
    "smoke": "playwright test --project=ecommerce --grep @smoke",
    "e2e": "playwright test --project=ecommerce --grep @e2e",
    "functional": "playwright test --project=ecommerce --grep @functional",
    "report": "playwright show-report",
    "allure:clean": "rimraf allure-results allure-report",
    "allure:generate": "allure generate ./allure-results --clean -o ./allure-report",
    "allure:open": "allure open ./allure-report",
    "allure:serve": "allure serve ./allure-results",
    "lint": "eslint pages tests fixtures utils config",
    "lint:fix": "eslint pages tests fixtures utils config --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "keywords": [
    "playwright",
    "typescript",
    "qa-automation",
    "e2e-testing",
    "page-object-model",
    "allure",
    "ci-cd"
  ],
  "author": "Jose Manuel Hernandez @thejmhh",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.42.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "allure-commandline": "^2.30.0",
    "allure-js-commons": "^3.0.0",
    "allure-playwright": "^3.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.0",
    "rimraf": "^5.0.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.0.0"
  },
  "dependencies": {
    "dotenv": "^16.4.0"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.json": [
      "prettier --write"
    ]
  }
}
